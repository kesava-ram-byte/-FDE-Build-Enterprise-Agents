STACKEXCHANGE_AGENT_CARD_URL=https://stackexchange-agent-<HASH>-uc.a.run.app/.well-known/agent-card.json
BQ_AGENT_CARD_URL=http://<BQ_AGENT_GKE_EXTERNAL_IP>:8080/a2a/app/.well-known/agent-card.json
